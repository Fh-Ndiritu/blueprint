<%= turbo_frame_tag "main_content", class: "flex w-full" do %>
  <div class="flex flex-col items-center w-full">
    <h1 class="font-bold text-4xl mb-4">Our top users today</h1>
    <div class="relative w-full max-w-3xl"
    data-controller="slider"
           data-slider-index-value="1"
           >
      <!--# we can set the index we want to be the first here-->
      <!--set data controller to connect to JS controller class-->
      <!--set the slider targets-->
      <!--Our top slider can now carry values we use to set default slide and even current one-->
      <div id="slider-container"
       class="flex flex-row gap-4 w-full overflow-x-scroll snap-x snap-mandatory rounded-xl p-3 scrollbar-hide"
       >
        <% @top_users.each do |user, messages| %>
          <!-- Each slider item is now full width and a flex-shrink-0 -->
          <div
          class="block slider-item snap-center bg-accent text-white rounded-xl shadow-2xl p-8 my-10 w-full "
          data-slider-target="item"
          >
            <div>
              <div class="flex-shrink-0">
                <% if user.profile.avatar.attached? %>
                  <%= image_tag user.profile.avatar, class: "h-20 w-20 rounded-full object-cover border-2 border-gray-200" %>
                <% else %>
                  <%= image_tag "https://placehold.co/80x80/282828/FFFFFF?text=P", class: "h-20 w-20 rounded-full border-2 border-gray-200" %>
                <% end %>
              </div>
              <h2 class="text-xl font-semibold mb-2">
                <%= "#{user.name} had #{messages.count} posts" %>
              </h2>
              <div>
                <p class="line-clamp-2 text-sm opacity-80">
                  <%= messages.first.content[..100] %>
                </p>
              </div>
            </div>
            <%= link_to "View Profile", profile_path(user), data: {turbo_frame: "_top"}, class: "btn cute-btn" %>
          </div>
        <% end %>
      </div>
      <!-- Navigation Buttons -->
      <!--We add slider actions -->
      <!--# buttons and links will inherit default actions -->
      <!--https://stimulus.hotwired.dev/handbook/building-something-real-->
      <button id="slider-left-btn"
      data-action="slider#prev"
        class="absolute left-0 top-1/2 -translate-y-1/2 transform bg-white p-2 rounded-full shadow-lg z-10 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent -ml-3">
        <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button
      id="slider-right-btn"
      data-action="slider#next"
      class="absolute right-0 top-1/2 -translate-y-1/2 transform bg-white p-2 rounded-full shadow-lg z-10 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent -mr-3">
        <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
<% end %>
